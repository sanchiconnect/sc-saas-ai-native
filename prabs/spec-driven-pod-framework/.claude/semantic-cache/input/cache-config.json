{
  "_meta": {
    "config_version": "1.2.0",
    "environment": "production",
    "last_updated": "2026-05-20T12:00:00Z",
    "updated_by": "platform-ops@company.com",
    "description": "SemanticCache configuration for customer-service chatbot optimization layer"
  },

  "cache_identity": {
    "cache_name": "customer-service-semantic-cache",
    "deployment_id": "cs-cache-prod-01",
    "model_version_key": "claude-haiku-4-5",
    "note": "model_version_key is used to namespace cache entries — changing it invalidates all existing entries and forces a cold start"
  },

  "lookup_settings": {
    "semantic_cache_enabled": true,
    "similarity_threshold": 0.92,
    "similarity_metric": "cosine",
    "top_k_candidates": 1,
    "exact_match_always_first": true,
    "normalize_before_hash": true,
    "normalization_rules": {
      "lowercase": true,
      "strip_leading_trailing_whitespace": true,
      "collapse_internal_whitespace": true,
      "remove_special_characters_except": ["?", ".", ",", "!"]
    }
  },

  "embedding_settings": {
    "embedding_model": "text-embedding-3-small",
    "embedding_dims": 1536,
    "embedding_batch_size": 100,
    "embedding_api_timeout_ms": 5000,
    "index_type": "flat_l2",
    "index_rebuild_on_startup": true,
    "incremental_index_updates": true,
    "note": "Use flat_l2 for <= 100K entries. Switch to hnsw for larger stores (set index_type to 'hnsw' with hnsw_m=32, hnsw_ef_construction=200)"
  },

  "ttl_policy": {
    "default_ttl_hours": 24,
    "ttl_by_source_tag": {
      "faq": 72,
      "billing_policy": 24,
      "refund_rules": 24,
      "subscription_policy": 24,
      "security_policy": 48,
      "data_policy": 48,
      "apology_template": 72,
      "escalation_script": 72,
      "pricing_policy": 72,
      "payment_methods": 72,
      "outage_response": 1,
      "payment_failure": 24,
      "sla": 24,
      "chargeback_policy": 24,
      "referral_program": 72,
      "account_management": 72
    },
    "expired_entry_purge_interval_minutes": 15,
    "max_entry_age_hours": 168
  },

  "storage_settings": {
    "cache_store_path": "./cache/semantic-cache.json",
    "vector_index_path": "./cache/vector-index.faiss",
    "source_hash_registry_path": "./cache/source-hashes.json",
    "max_cache_size_entries": 10000,
    "eviction_policy": "lru",
    "eviction_batch_size": 500,
    "persistence_write_interval_seconds": 30
  },

  "safety_settings": {
    "never_cache_patterns": [
      "customer_id",
      "account_number",
      "personal_data",
      "real_time_balance",
      "social security",
      "ssn",
      "date of birth",
      "credit card number",
      "cvv",
      "routing number",
      "my account",
      "my order",
      "my balance",
      "my invoice",
      "order #",
      "ticket #"
    ],
    "never_cache_regex_patterns": [
      "\\b\\d{10,16}\\b",
      "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "\\b[0-9]{3}-[0-9]{2}-[0-9]{4}\\b"
    ],
    "semantic_hit_warning_required": true,
    "semantic_hit_warning_message": "semantic_match_verify_appropriateness",
    "require_verification_above_similarity": 0.92,
    "require_human_review_below_similarity": 0.95,
    "pii_bypass_action": "pass_through_no_cache"
  },

  "invalidation_settings": {
    "source_document_hashes": {
      "billing_policy_pdf": "sha256:3c4f9e2a1b8d70561234567890abcdef12345678901234567890abcdef123456ab",
      "refund_policy_md": "sha256:7d8e3f1b2c90a4672345678901234567890abcdef12345678901234567890abcd12",
      "terms_of_service_html": "sha256:a1b2c3d4e5f6078923456789012345678901234567890abcdef123456789012345e",
      "faq_knowledge_base_json": "sha256:f9e8d7c6b5a40321456789012345678901234567890abcdef12345678901234567f"
    },
    "source_check_interval_minutes": 60,
    "invalidation_webhook_url": "https://internal.company.com/cache/invalidate",
    "invalidation_webhook_auth_header": "X-Cache-Invalidation-Token",
    "log_all_invalidations": true,
    "invalidation_log_path": "./logs/cache-invalidation.log"
  },

  "metrics_settings": {
    "metrics_enabled": true,
    "metrics_rolling_window_days": 30,
    "metrics_export_path": "./output/cache-metrics.json",
    "metrics_export_interval_hours": 1,
    "track_per_query_hit_rates": true,
    "track_tokens_avoided": true,
    "token_cost_per_1k_input_usd": 0.003,
    "token_cost_per_1k_output_usd": 0.015,
    "average_tokens_per_invocation": 840
  },

  "operational_settings": {
    "warm_cache_on_startup": true,
    "warm_cache_from_file": "./cache/semantic-cache.json",
    "health_check_endpoint": "/cache/health",
    "admin_api_enabled": true,
    "admin_api_auth_required": true,
    "log_level": "info",
    "log_cache_hits": false,
    "log_cache_misses": true,
    "log_semantic_hits": true,
    "log_pii_bypasses": true
  }
}
